<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Design tokens for the light Fluent/Metro inspired look.
    Everything visual references these keys, so the palette can be retuned in one place.
  -->

  <!-- Surfaces -->
  <Color x:Key="AppBackgroundColor">#F4F5F7</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="SurfaceAltColor">#FAFBFC</Color>
  <Color x:Key="SurfaceSunkenColor">#EDEFF2</Color>

  <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
  <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{StaticResource SurfaceSunkenColor}" />

  <!-- Lines -->
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E6E8EC" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#CDD2DA" />

  <!-- Accent -->
  <Color x:Key="AccentColor">#2563EB</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8EFFE" />
  <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#DCE7FD" />

  <!-- Text -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1F27" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6472" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8B95A4" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

  <!-- Semantic -->
  <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEECEC" />
  <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#FEF5E7" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E9F7EF" />
  <SolidColorBrush x:Key="FavoriteBrush" Color="#F59E0B" />

  <!-- Placeholder tile for games without artwork -->
  <LinearGradientBrush x:Key="PlaceholderBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#DDE3EC" />
    <GradientStop Offset="1" Color="#C3CCDA" />
  </LinearGradientBrush>

  <!-- Geometry -->
  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">12</CornerRadius>

  <!-- Typography -->
  <x:Double x:Key="FontSizeCaption">11</x:Double>
  <x:Double x:Key="FontSizeSmall">12</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeMedium">15</x:Double>
  <x:Double x:Key="FontSizeLarge">19</x:Double>
  <x:Double x:Key="FontSizeTitle">26</x:Double>

  <!-- Elevation -->
  <BoxShadows x:Key="ShadowCard">0 1 2 0 #14000000</BoxShadows>
  <BoxShadows x:Key="ShadowCardHover">0 6 16 0 #22000000</BoxShadows>
  <BoxShadows x:Key="ShadowPanel">0 2 10 0 #10000000</BoxShadows>

</ResourceDictionary>
