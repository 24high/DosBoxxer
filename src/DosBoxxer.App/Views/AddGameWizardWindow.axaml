<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="using:DosBoxxer.App.Views"
                xmlns:loc="using:DosBoxxer.App.Localization"
                x:Class="DosBoxxer.App.Views.AddGameWizardWindow"
                Title="{loc:Localize Wizard.Title}"
                Width="760" Height="620"
                MinWidth="620" MinHeight="520"
                Background="{DynamicResource AppBackgroundBrush}">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header -->
    <Border Grid.Row="0" Classes="panel" BorderThickness="0,0,0,1" Padding="26,18">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="tertiary" Text="{Binding StepIndicator}" />
          <Border Grid.Column="1" Classes="chip" IsVisible="{Binding IsBatchMode}">
            <TextBlock Text="{Binding BatchProgressText}" />
          </Border>
        </Grid>
        <TextBlock Classes="h1" Text="{loc:Localize Wizard.Step1Title}" IsVisible="{Binding IsStep1}" />
        <TextBlock Classes="h1" Text="{loc:Localize Wizard.Step2Title}" IsVisible="{Binding IsStep2}" />
        <TextBlock Classes="h1" Text="{loc:Localize Wizard.Step3Title}" IsVisible="{Binding IsStep3}" />
        <TextBlock Classes="h1" Text="{loc:Localize Wizard.Step5Title}" IsVisible="{Binding IsStep4}" />
        <TextBlock Classes="h1" Text="{loc:Localize Wizard.Step4Title}" IsVisible="{Binding IsStep5}" />
      </StackPanel>
    </Border>

    <!-- Body -->
    <ScrollViewer Grid.Row="1" Padding="26,20" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">

        <!-- ===================== Step 1 ===================== -->
        <StackPanel Spacing="12" IsVisible="{Binding IsStep1}">
          <TextBlock Classes="secondary wrap" Text="{loc:Localize Wizard.Step1Description}" />
          <StackPanel Spacing="6">
            <TextBlock Classes="sectionLabel" Text="{loc:Localize Wizard.GameFolder}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0"
                       Margin="0,0,8,0"
                       Text="{Binding GameFolder, Mode=TwoWay}"
                       AutomationProperties.Name="{loc:Localize Wizard.GameFolder}" />
              <Button Grid.Column="1"
                      Content="{loc:Localize Common.Browse}"
                      Command="{Binding BrowseFolderCommand}" />
            </Grid>
          </StackPanel>
        </StackPanel>

        <!-- ===================== Step 2 ===================== -->
        <StackPanel Spacing="12" IsVisible="{Binding IsStep2}">
          <TextBlock Classes="secondary wrap" Text="{loc:Localize Wizard.Step2Description}" />

          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsScanning}">
            <ProgressBar IsIndeterminate="True" Width="140" VerticalAlignment="Center" />
            <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{loc:Localize Wizard.Scanning}" />
          </StackPanel>

          <TextBlock Classes="secondary wrap"
                     Text="{loc:Localize Wizard.NoExecutablesFound}"
                     IsVisible="{Binding ShowNoCandidates}" />

          <ListBox Classes="plain"
                   Height="330"
                   ItemsSource="{Binding Candidates}"
                   SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                   IsVisible="{Binding HasCandidates}"
                   AutomationProperties.Name="{loc:Localize Wizard.Step2Title}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto" >
                  <Border Grid.Column="0" Classes="chip" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Kind}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                    <TextBlock Classes="tertiary" Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2"
                             Classes="tertiary"
                             VerticalAlignment="Center"
                             Text="{Binding UtilityHint}"
                             IsVisible="{Binding LooksLikeUtility}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <!-- ===================== Step 3 ===================== -->
        <StackPanel Spacing="12" IsVisible="{Binding IsStep3}">
          <TextBlock Classes="secondary wrap" Text="{loc:Localize Wizard.Step3Description}" />

          <StackPanel Spacing="6">
            <TextBlock Classes="sectionLabel" Text="{loc:Localize Wizard.SearchTerm}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0"
                       Margin="0,0,8,0"
                       Text="{Binding SearchTerm, Mode=TwoWay}"
                       AutomationProperties.Name="{loc:Localize Wizard.SearchTerm}" />
              <Button Grid.Column="1"
                      Content="{loc:Localize Common.Search}"
                      Command="{Binding SearchCommand}" />
            </Grid>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsSearching}">
            <ProgressBar IsIndeterminate="True" Width="140" VerticalAlignment="Center" />
            <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{loc:Localize Wizard.Searching}" />
          </StackPanel>

          <Border Classes="infoBanner" IsVisible="{Binding HasInfoMessage}">
            <TextBlock Classes="wrap" Text="{Binding InfoMessage}" />
          </Border>

          <TextBlock Classes="sectionLabel" Text="{loc:Localize Wizard.SearchResults}" />

          <ListBox Classes="plain"
                   Height="230"
                   ItemsSource="{Binding SearchResults}"
                   SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                   AutomationProperties.Name="{loc:Localize Wizard.SearchResults}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Classes="tertiary"
                             Text="{Binding Subtitle}"
                             IsVisible="{Binding HasSubtitle}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Classes="tertiary wrap" Text="{loc:Localize Wizard.MetadataOptional}" />
        </StackPanel>

        <!-- ===================== Step 4 : Savegames / Cloud Saves ===================== -->
        <StackPanel Spacing="14" IsVisible="{Binding IsStep4}">
          <TextBlock Classes="secondary wrap" Text="{loc:Localize Wizard.Step5Description}" />

          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Margin="0,0,8,0"
                     Watermark="{loc:Localize Savegame.SearchTerm}"
                     Text="{Binding SavegameEditor.SearchTerm, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="{loc:Localize Savegame.SearchAgain}"
                    Command="{Binding SavegameEditor.SearchCommand}" />
          </Grid>

          <TextBlock Classes="tertiary" Text="{loc:Localize Savegame.Searching}"
                     IsVisible="{Binding SavegameEditor.IsSearching}" />

          <!-- Suggestions -->
          <StackPanel Spacing="6" IsVisible="{Binding SavegameEditor.HasSuggestions}">
            <TextBlock Classes="sectionLabel" Text="{loc:Localize Savegame.Suggestions}" />
            <ListBox ItemsSource="{Binding SavegameEditor.Suggestions}"
                     SelectedItem="{Binding SavegameEditor.SelectedSuggestion, Mode=TwoWay}"
                     MaxHeight="180">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="2">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding Title}" />
                      <TextBlock Classes="mono tertiary" Text="{Binding Pattern}" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center" Margin="6,0">
                      <TextBlock Text="{Binding ConfidenceLabel}" />
                    </Border>
                    <TextBlock Grid.Column="2" Classes="tertiary" VerticalAlignment="Center" Text="{Binding ScoreText}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{loc:Localize Common.Select}" Classes="primary"
                      Command="{Binding SavegameEditor.ApplySuggestionCommand}" />
              <Button Content="{loc:Localize Savegame.NoMatchOption}"
                      Command="{Binding SavegameEditor.UseNoMatchCommand}" />
            </StackPanel>
          </StackPanel>

          <CheckBox Content="{loc:Localize Savegame.SkipOption}"
                    IsChecked="{Binding SavegameEditor.SkipSavegames, Mode=TwoWay}" />

          <!-- Manual entries -->
          <StackPanel Spacing="6" IsVisible="{Binding !SavegameEditor.SkipSavegames}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="sectionLabel" Text="{loc:Localize Savegame.Entries}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="{loc:Localize Savegame.AddEntry}"
                      Command="{Binding SavegameEditor.AddEntryCommand}" />
            </Grid>
            <TextBlock Classes="tertiary wrap" Text="{loc:Localize Savegame.EntriesHint}" />
            <TextBlock Classes="tertiary" Text="{loc:Localize Savegame.NoEntries}"
                       IsVisible="{Binding !SavegameEditor.HasEntries}" />
            <ItemsControl ItemsSource="{Binding SavegameEditor.Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
                    <TextBox Grid.Column="0" Margin="0,0,8,0"
                             Watermark="{loc:Localize Savegame.Pattern}"
                             Text="{Binding Pattern, Mode=TwoWay}" />
                    <CheckBox Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center"
                              Content="{loc:Localize Savegame.KindGlob}"
                              IsChecked="{Binding IsGlob, Mode=TwoWay}" />
                    <Button Grid.Column="2" Content="{loc:Localize Savegame.RemoveEntry}"
                            Command="{Binding $parent[ItemsControl].DataContext.SavegameEditor.RemoveEntryCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>

        <!-- ===================== Step 5 : Review ===================== -->
        <StackPanel Spacing="14" IsVisible="{Binding IsStep5}">
          <TextBlock Classes="secondary wrap" Text="{loc:Localize Wizard.Step4Description}" />

          <StackPanel Spacing="6">
            <TextBlock Classes="sectionLabel" Text="{loc:Localize Wizard.GameTitle}" />
            <TextBox Text="{Binding GameTitle, Mode=TwoWay}"
                     AutomationProperties.Name="{loc:Localize Wizard.GameTitle}" />
          </StackPanel>

          <Border Classes="card" Padding="18">
            <StackPanel Spacing="9">
              <Grid ColumnDefinitions="150,*" IsVisible="{Binding HasReviewYear}">
                <TextBlock Grid.Column="0" Classes="secondary" Text="{loc:Localize Details.Year}" />
                <TextBlock Grid.Column="1" Text="{Binding ReviewYear}" />
              </Grid>
              <Grid ColumnDefinitions="150,*" IsVisible="{Binding HasReviewPublisher}">
                <TextBlock Grid.Column="0" Classes="secondary" Text="{loc:Localize Details.Publisher}" />
                <TextBlock Grid.Column="1" Classes="wrap" Text="{Binding ReviewPublisher}" />
              </Grid>
              <Grid ColumnDefinitions="150,*" IsVisible="{Binding HasReviewDeveloper}">
                <TextBlock Grid.Column="0" Classes="secondary" Text="{loc:Localize Details.Developer}" />
                <TextBlock Grid.Column="1" Classes="wrap" Text="{Binding ReviewDeveloper}" />
              </Grid>
              <Grid ColumnDefinitions="150,*" IsVisible="{Binding HasReviewGenres}">
                <TextBlock Grid.Column="0" Classes="secondary" Text="{loc:Localize Details.Genre}" />
                <TextBlock Grid.Column="1" Classes="wrap" Text="{Binding ReviewGenres}" />
              </Grid>
              <Grid ColumnDefinitions="150,*">
                <TextBlock Grid.Column="0" Classes="secondary" Text="{loc:Localize Edit.LaunchFile}" />
                <TextBlock Grid.Column="1" Classes="mono wrap" Text="{Binding ReviewLaunchFile}" />
              </Grid>
              <Grid ColumnDefinitions="150,*">
                <TextBlock Grid.Column="0" Classes="secondary" Text="{loc:Localize Edit.GameDirectory}" />
                <TextBlock Grid.Column="1" Classes="mono wrap" Text="{Binding ReviewFolder}" />
              </Grid>
              <Grid ColumnDefinitions="150,*">
                <TextBlock Grid.Column="0" Classes="secondary" Text="{loc:Localize Savegame.ReviewTitle}" />
                <TextBlock Grid.Column="1" Classes="wrap" Text="{Binding ReviewSavegames}" />
              </Grid>

              <TextBlock Classes="tertiary"
                         Text="{Binding ReviewMetadataState}"
                         IsVisible="{Binding HasNoMetadata}" />
            </StackPanel>
          </Border>

          <Border Classes="infoBanner" IsVisible="{Binding HasInfoMessage}">
            <TextBlock Classes="wrap" Text="{Binding InfoMessage}" />
          </Border>
        </StackPanel>

        <!-- Validation -->
        <Border Classes="errorBanner" IsVisible="{Binding HasValidationMessage}">
          <TextBlock Classes="wrap" Text="{Binding ValidationMessage}" />
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="2" Classes="panel" BorderThickness="0,1,0,0" Padding="26,14">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
        <Button Grid.Column="0"
                Content="{loc:Localize Common.Cancel}"
                Command="{Binding CancelCommand}" />

        <!-- Batch only: skip this game and continue with the next directory. -->
        <Button Grid.Column="1"
                Margin="8,0,0,0"
                Content="{loc:Localize BulkAdd.SkipGame}"
                Command="{Binding SkipGameCommand}"
                IsVisible="{Binding IsBatchMode}" />

        <Button Grid.Column="3"
                Margin="0,0,8,0"
                Content="{loc:Localize Common.Back}"
                Command="{Binding BackCommand}"
                IsEnabled="{Binding CanGoBack}" />

        <Button Grid.Column="4"
                Margin="0,0,8,0"
                Content="{loc:Localize Wizard.SkipMetadata}"
                Command="{Binding SkipMetadataCommand}"
                IsVisible="{Binding ShowSkipMetadata}" />

        <Button Grid.Column="5"
                Classes="primary"
                Content="{loc:Localize Common.Next}"
                Command="{Binding NextCommand}"
                IsVisible="{Binding ShowNext}" />

        <Button Grid.Column="5"
                Classes="primary"
                Content="{loc:Localize Wizard.AddGame}"
                Command="{Binding FinishCommand}"
                IsEnabled="{Binding !IsBusy}"
                IsVisible="{Binding IsStep5}" />
      </Grid>
    </Border>
  </Grid>
</v:DialogWindow>
