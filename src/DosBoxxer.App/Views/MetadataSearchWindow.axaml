<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="using:DosBoxxer.App.Views"
                xmlns:loc="using:DosBoxxer.App.Localization"
                x:Class="DosBoxxer.App.Views.MetadataSearchWindow"
                Title="{loc:Localize Wizard.Step3Title}"
                Width="620" Height="520"
                MinWidth="480" MinHeight="400"
                Background="{DynamicResource SurfaceBrush}">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="26">

    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
      <TextBlock Classes="h1" Text="{loc:Localize Wizard.Step3Title}" />
      <TextBlock Classes="secondary wrap" Text="{loc:Localize Wizard.Step3Description}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <TextBox Grid.Column="0"
               Margin="0,0,8,0"
               Text="{Binding SearchTerm, Mode=TwoWay}"
               AutomationProperties.Name="{loc:Localize Wizard.SearchTerm}" />
      <Button Grid.Column="1"
              Classes="primary"
              Content="{loc:Localize Common.Search}"
              Command="{Binding SearchCommand}"
              IsDefault="True" />
    </Grid>

    <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto">
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8"
                  IsVisible="{Binding IsSearching}">
        <ProgressBar IsIndeterminate="True" Width="140" VerticalAlignment="Center" />
        <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{loc:Localize Wizard.Searching}" />
      </StackPanel>

      <ListBox Grid.Row="1"
               Classes="plain"
               ItemsSource="{Binding Results}"
               SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
               AutomationProperties.Name="{loc:Localize Wizard.SearchResults}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="1">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
              <TextBlock Classes="tertiary" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="2" Classes="infoBanner" Margin="0,10,0,0" IsVisible="{Binding HasInfoMessage}">
        <TextBlock Classes="wrap" Text="{Binding InfoMessage}" />
      </Border>
    </Grid>

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,16,0,0">
      <Button Content="{loc:Localize Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
      <Button Classes="primary"
              Content="{loc:Localize Common.Select}"
              Command="{Binding ConfirmCommand}"
              IsEnabled="{Binding HasResults}" />
    </StackPanel>
  </Grid>
</v:DialogWindow>
